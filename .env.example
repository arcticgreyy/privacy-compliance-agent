# ─── Database ────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/privacy_compliance?schema=public"

# ─── Auth ────────────────────────────────────────────────────────────
AUTH_SECRET="replace-with-random-secret-in-production"

# ─── AI Engine (choose one) ──────────────────────────────────────────
OPENAI_API_KEY=""
# GOOGLE_GEMINI_API_KEY=""

# ─── GCP (for Cloud Tasks / Cloud Run) ──────────────────────────────
# GCP_PROJECT_ID=""
# GCP_REGION="us-central1"
# CLOUD_TASKS_QUEUE="privacy-scans"
# WORKER_SERVICE_URL="https://scanner-worker-xxxxx.run.app"

# ─── Playwright Worker ──────────────────────────────────────────────
# Leave empty to launch a local browser; set to ws:// URL for remote browser
BROWSER_WS_ENDPOINT=""

# ─── Cron Security ──────────────────────────────────────────────────
CRON_SECRET="replace-with-random-secret-in-production"
